{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zega.dev/schemas/v2/contract.schema.json",
  "title": "Graph-component contract, format 2 (APS 21): plain typed data",
  "description": "What a graph component accepts, as plain typed data (Sami, 15 Nov): `data` is a JSON Schema, in the interpreter's subset (src/schema.ts), for the data a view spec carries inline; `options` are its display settings. Data comes from anywhere: the assistant's own tools, the knowledge graph, the model, or a ZQL result through the optional `zql` adapter. Agents read this file to write a view spec; every host validates view specs against it (src/validate.ts) before anything renders.",
  "type": "object",
  "required": ["format", "id", "version", "title", "category", "description", "surface", "marks", "size", "data", "options", "examples"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": 2, "description": "The contract format major. Format 1 (schemas/contract.v1.schema.json) binds ZQL results only." },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "maxLength": 64 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$",
      "description": "The component's semver. Major: an existing view spec may stop validating. Minor: something added (a field, an option). Patch: rendering only."
    },
    "title": { "type": "string", "minLength": 1 },
    "category": { "enum": ["Math", "Finance", "Geo", "Charts", "Network", "Sports", "Anatomy"] },
    "description": { "type": "string", "minLength": 1, "description": "When to use it, in a sentence or two: the model reads this to choose." },
    "surface": { "$ref": "#/$defs/surface" },
    "marks": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z-]*$" }, "description": "The marks it draws (path, line, area, point, candle, bar, heat…)." },
    "size": {
      "type": "object",
      "required": ["aspect", "minHeight", "maxHeight"],
      "additionalProperties": false,
      "description": "Inline in a column (a chat answer, a card): the width is the column's; the height is width × aspect, kept inside [minHeight, maxHeight] points. rixse APS 4's medium size.",
      "properties": {
        "aspect": { "type": "number", "minimum": 0.3, "maximum": 1.5 },
        "minHeight": { "type": "integer", "minimum": 120, "maximum": 800 },
        "maxHeight": { "type": "integer", "minimum": 120, "maximum": 1200 }
      }
    },
    "data": { "type": "object", "description": "A JSON Schema for the view spec's `data`: properties, required, additionalProperties, items, prefixItems, min/maxItems, type, enum, const, minimum/maximum, min/maxLength, pattern, oneOf, $ref (into this contract's `$defs`)." },
    "$defs": { "type": "object", "description": "Shared definitions the data schema refers to as #/$defs/<name>." },
    "options": { "type": "object", "additionalProperties": { "$ref": "#/$defs/setting" } },
    "examples": {
      "type": "object",
      "required": ["valid", "invalid"],
      "additionalProperties": false,
      "properties": {
        "valid": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/example" } },
        "invalid": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/invalidExample" } }
      }
    },
    "zql": {
      "type": "object",
      "description": "Optional: how a ZQL result binds to this component (format 1's roles), for zega's explorer. ZQL is one source of data among several.",
      "required": ["data", "roles", "surfaceParams", "options", "examples"],
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "object",
          "required": ["groups", "description"],
          "additionalProperties": false,
          "properties": {
            "minRows": { "type": "integer", "minimum": 0 },
            "groups": { "enum": ["none", "optional", "required"] },
            "description": { "type": "string" }
          }
        },
        "roles": { "type": "object", "additionalProperties": { "$ref": "#/$defs/role" } },
        "surfaceParams": { "type": "object", "additionalProperties": { "$ref": "#/$defs/setting" } },
        "options": { "type": "object", "additionalProperties": { "$ref": "#/$defs/setting" }, "description": "Options only zega's runtime has (e.g. the basemap archive), beside the contract's own." },
        "examples": {
          "type": "object",
          "required": ["valid", "invalid"],
          "additionalProperties": false,
          "properties": {
            "sample": { "type": "string" },
            "zql": { "type": "string" },
            "valid": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/example" } },
            "invalid": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/invalidExample" } }
          }
        }
      }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "required": ["kind", "description"],
      "additionalProperties": false,
      "description": "The coordinate space the marks are drawn in. `art`: an illustrated surface (a rink, a court, a body diagram): `art` names its drawing, `frame` its coordinate system, and `regions` the named areas data may refer to by id.",
      "properties": {
        "kind": { "enum": ["plane", "time", "map", "globe", "art"] },
        "description": { "type": "string" },
        "art": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "frame": {
          "type": "object",
          "required": ["x", "y", "unit"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
            "y": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
            "unit": { "enum": ["ft", "m", "yd", "unit"] }
          }
        },
        "regions": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" }, "maxItems": 256 }
      }
    },
    "valueType": { "enum": ["Point", "Float", "Int", "Bool", "String", "Enum", "XY"] },
    "unit": { "enum": ["ft", "m", "deg", "pct", "fraction", "km/h", "yd", "s"] },
    "role": {
      "type": "object",
      "required": ["per", "type", "required", "description"],
      "additionalProperties": false,
      "properties": {
        "per": { "enum": ["row", "group", "result"] },
        "type": { "$ref": "#/$defs/valueType" },
        "shape": { "enum": ["one", "list", "list<list>"] },
        "required": { "type": "boolean" },
        "unit": { "$ref": "#/$defs/unit" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "enum": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "frame": { "type": "string" },
        "relativeTo": { "type": "string" },
        "unique": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "setting": {
      "type": "object",
      "required": ["default", "description"],
      "additionalProperties": false,
      "properties": {
        "default": {},
        "description": { "type": "string" },
        "type": { "oneOf": [{ "$ref": "#/$defs/jsonType" }, { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/jsonType" } }] },
        "enum": { "type": "array", "minItems": 1 },
        "const": {},
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" },
        "items": { "type": "object" },
        "prefixItems": { "type": "array", "items": { "type": "object" } },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 },
        "format": { "enum": ["lonlat-bounds"] }
      }
    },
    "jsonType": { "enum": ["string", "number", "integer", "boolean", "array", "object", "null"] },
    "example": {
      "type": "object",
      "required": ["title", "spec"],
      "additionalProperties": false,
      "properties": { "title": { "type": "string" }, "spec": { "type": "object" } }
    },
    "invalidExample": {
      "type": "object",
      "required": ["title", "spec", "error"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "spec": { "type": "object" },
        "error": { "type": "object", "description": "The first error the validator gives, exactly (code, at, message, help; fix when there is one)." }
      }
    }
  }
}

{
  "$schema": "../../schemas/contract.schema.json",
  "format": 2,
  "id": "path-on-map",
  "version": "2.1.0",
  "title": "Path on map",
  "category": "Geo",
  "description": "Ordered paths (a race lap, a route, a run, a trip) on the street map, coloured by an optional value per point (speed, distance, elevation), each with a start marker and label; tilted so buildings stand up (3D) unless the view says otherwise, and the reader can switch 2D | 3D. Points are [longitude, latitude], in path order.",
  "surface": {
    "kind": "map",
    "description": "The host’s street map (MapLibre): its basemap, or the plain ground where there is none. The component adds the paths, their casing, start markers, labels, the legend and the extruded buildings: the buildings, casing and paths under the basemap’s labels, the start markers and path labels over them."
  },
  "marks": [
    "path",
    "point",
    "label"
  ],
  "size": {
    "aspect": 0.62,
    "minHeight": 240,
    "maxHeight": 460
  },
  "data": {
    "type": "object",
    "required": [
      "paths"
    ],
    "additionalProperties": false,
    "properties": {
      "paths": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "description": "One or more paths, each its own line.",
        "items": {
          "type": "object",
          "required": [
            "points"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 60,
              "description": "The path’s name, shown at its start."
            },
            "points": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5000,
              "description": "[longitude, latitude] per point, in path order; the first is the start.",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "number",
                    "minimum": -85.0511,
                    "maximum": 85.0511
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            },
            "values": {
              "type": "array",
              "maxItems": 5000,
              "description": "A number per point (null: none), one per point; each segment takes its start point’s colour.",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      },
      "valueName": {
        "type": "string",
        "maxLength": 40,
        "description": "What the values are, for the legend (\"speed\")."
      }
    }
  },
  "options": {
    "colorScale": {
      "enum": [
        "sequential",
        "diverging",
        "solid"
      ],
      "default": "sequential",
      "description": "sequential: one hue, light to dark with the value. diverging: two hues around the value's midpoint. solid: the accent colour, value ignored."
    },
    "valueUnit": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ft",
        "m",
        "deg",
        "pct",
        "fraction",
        "km/h",
        "yd",
        "s",
        null
      ],
      "default": null,
      "description": "The value's unit, for the legend."
    },
    "lineWidth": {
      "type": "number",
      "minimum": 1,
      "maximum": 16,
      "default": 6,
      "description": "Path width in CSS pixels."
    },
    "view": {
      "enum": [
        "auto",
        "2d",
        "3d"
      ],
      "default": "3d",
      "description": "How the map opens: 3d (the default) tilts the camera (pitch 60°) so buildings stand up; 2d looks straight down, the buildings flat; auto is 2d when what is framed (the paths, or bounds) spans 5 km or less corner to corner, else 3d. On a map the reader can move, the 2D | 3D switch in its controls changes it."
    },
    "mapType": {
      "enum": [
        "map",
        "satellite"
      ],
      "default": "map",
      "description": "What is under the paths, roads and names: map, the street map (the default); satellite, imagery where the basemap has some (10 m, so the street map fades back in past zoom 13). On a map the reader can move whose basemap has imagery, the Map | Satellite switch in its controls changes it."
    },
    "bearing": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "default": 0,
      "description": "Camera bearing in degrees, clockwise from north."
    },
    "showBuildings": {
      "type": "boolean",
      "default": true,
      "description": "Extrude buildings to their OSM heights."
    },
    "bounds": {
      "type": [
        "array",
        "null"
      ],
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -85.0511,
          "maximum": 85.0511
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -85.0511,
          "maximum": 85.0511
        }
      ],
      "minItems": 4,
      "maxItems": 4,
      "format": "lonlat-bounds",
      "default": null,
      "description": "[west, south, east, north] to frame; null frames the paths."
    }
  },
  "examples": {
    "valid": [
      {
        "title": "Speed along a short run, tilted (the default view, 3d)",
        "spec": {
          "component": "path-on-map",
          "data": {
            "valueName": "speed",
            "paths": [
              {
                "label": "Seawall",
                "points": [
                  [
                    -123.1405,
                    49.2936
                  ],
                  [
                    -123.144,
                    49.299
                  ],
                  [
                    -123.149,
                    49.302
                  ],
                  [
                    -123.14,
                    49.305
                  ]
                ],
                "values": [
                  11,
                  13,
                  12,
                  14
                ]
              }
            ]
          },
          "options": {
            "valueUnit": "km/h"
          }
        }
      },
      {
        "title": "A route from above, one colour",
        "spec": {
          "component": "path-on-map",
          "data": {
            "paths": [
              {
                "label": "To the station",
                "points": [
                  [
                    7.4212,
                    43.735
                  ],
                  [
                    7.423,
                    43.738
                  ],
                  [
                    7.426,
                    43.7395
                  ]
                ]
              }
            ]
          },
          "options": {
            "view": "2d",
            "colorScale": "solid",
            "showBuildings": false
          }
        }
      }
    ],
    "invalid": [
      {
        "title": "A path with one point",
        "spec": {
          "component": "path-on-map",
          "data": {
            "paths": [
              {
                "points": [
                  [
                    7.42,
                    43.73
                  ]
                ]
              }
            ]
          }
        },
        "error": {
          "code": "length",
          "at": "data.paths[0].points",
          "message": "needs at least 2 items, got 1",
          "help": "[longitude, latitude] per point, in path order; the first is the start."
        }
      },
      {
        "title": "Values that do not match the points",
        "spec": {
          "component": "path-on-map",
          "data": {
            "paths": [
              {
                "points": [
                  [
                    7.42,
                    43.73
                  ],
                  [
                    7.43,
                    43.74
                  ]
                ],
                "values": [
                  1
                ]
              }
            ]
          }
        },
        "error": {
          "code": "values-length",
          "at": "data.paths[0].values",
          "message": "path 0 has 2 points and 1 values",
          "help": "one value per point (null for a point with none), or no values at all"
        }
      }
    ]
  },
  "zql": {
    "data": {
      "groups": "optional",
      "minRows": 2,
      "description": "Each row is one point of a path, in path order: select it with `order by`. Ungrouped, the rows are one path; grouped, each group's rows are one path."
    },
    "roles": {
      "path": {
        "per": "row",
        "type": "Point",
        "required": true,
        "description": "The row's position. The first row of each path is its start."
      },
      "value": {
        "per": "row",
        "type": "Float",
        "required": false,
        "description": "A number per point (speed, distance, sector…). Each segment takes its start point's colour."
      },
      "label": {
        "per": "group",
        "type": "String",
        "required": false,
        "description": "The path's name, shown at its start."
      }
    },
    "surfaceParams": {
      "basemap": {
        "enum": [
          "auto",
          "cities",
          "monaco"
        ],
        "default": "auto",
        "description": "Which street-map archive to draw under the paths. auto picks the one that covers them."
      }
    },
    "options": {
      "view": {
        "enum": [
          "2d",
          "3d"
        ],
        "default": "3d",
        "description": "2d looks straight down; 3d tilts the camera (pitch 60°) so buildings stand up. Format 1 (zega's explorer) has no auto."
      }
    },
    "examples": {
      "sample": "samples/monaco.zql",
      "zql": "query {\n  Circuit(name: \"Circuit de Monaco\") {\n    name\n    points <- TrackPoint order by seq { at speed dist }\n  }\n}",
      "valid": [
        {
          "title": "Speed around the lap, in 3D",
          "spec": {
            "format": 1,
            "component": "path-on-map",
            "version": "1",
            "binding": {
              "rows": "points",
              "path": "at",
              "value": "speed",
              "label": "name"
            },
            "options": {
              "valueUnit": "km/h",
              "bearing": -30
            }
          }
        },
        {
          "title": "Distance along the lap, from above",
          "spec": {
            "format": 1,
            "component": "path-on-map",
            "version": "1",
            "binding": {
              "rows": "points",
              "path": "at",
              "value": "dist"
            },
            "options": {
              "view": "2d",
              "colorScale": "diverging",
              "valueUnit": "m",
              "lineWidth": 8
            }
          }
        },
        {
          "title": "The line alone, no buildings",
          "spec": {
            "format": 1,
            "component": "path-on-map",
            "version": "1",
            "binding": {
              "rows": "points",
              "path": "at",
              "label": "name"
            },
            "options": {
              "view": "2d",
              "colorScale": "solid",
              "showBuildings": false
            }
          }
        }
      ],
      "invalid": [
        {
          "title": "A misspelt row field",
          "spec": {
            "format": 1,
            "component": "path-on-map",
            "version": "1",
            "binding": {
              "rows": "points",
              "path": "at",
              "value": "sped"
            }
          },
          "error": {
            "code": "unresolved",
            "at": "binding.value",
            "message": "`sped` is not in each row of `points`",
            "help": "did you mean `speed`?",
            "fix": {
              "kind": "safe",
              "patch": [
                {
                  "op": "replace",
                  "path": "/binding/value",
                  "value": "speed"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
